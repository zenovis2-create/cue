+    const id={run_id:'r-i4',thread_id:'th',item_id:'item',approval_id:null}; db.prepare("INSERT INTO artifact(task_id,run_id,kind,content,created_at) VALUES('t-i4','r-i4','claimed_approval','yes',?)").run(now);
