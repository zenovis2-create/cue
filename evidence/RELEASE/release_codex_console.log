diff --git a/docs/P5_SPEC.md b/docs/P5_SPEC.md
index 37aa9201599d15a696d1099fb22088156b4eb7a9..fd6ca747a9a1dca690b6feaf7f6dedf9a779600c
--- a/docs/P5_SPEC.md
