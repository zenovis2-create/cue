+  return out;
+}
+const forbidden=['acceptForSession','acceptWithExecpolicyAmendment','applyNetworkPolicyAmendment','scope: "session"','--yolo','--accept-hooks','--dangerously-bypass','--approve-for-me','-a never','git reset --hard'] as const;
