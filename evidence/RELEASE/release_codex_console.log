+function temp(prefix:string):string { const root=mkdtempSync(resolve(`.test-state-${prefix}-`)); roots.push(root); return root; }
+afterEach(()=>{ for(const root of roots.splice(0)) rmSync(root,{recursive:true,force:true}); });
