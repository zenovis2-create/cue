+    expect(spawnSync('git',['init','--quiet'],{cwd:worktree}).status).toBe(0);
+    const seeded=seed(dbPath,worktree,'crash'); seeded.db.prepare("UPDATE task SET id='t-crash' WHERE id='t-crash'").run(); seeded.db.close();
