+  const config=Object.freeze({version:1,ledgerPath:resolve(defaults.ledgerPath??join(userDataPath,'cue-ledger.sqlite')),worktreeRoot:realpathSync.native(resolve(defaults.worktreeRoot??process.cwd()))});
