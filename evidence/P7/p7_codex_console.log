+  id TEXT PRIMARY KEY,
+  task_id TEXT NOT NULL REFERENCES task(id),
+  surface TEXT NOT NULL CHECK (surface IN ('work','explain')),
+  page_id TEXT,
+  artifact_id TEXT,
+  artifact_version INTEGER,
+  url_label TEXT,
+  selector TEXT,
+  screenshot_id TEXT NOT NULL,
