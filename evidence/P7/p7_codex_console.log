+    "P7-7": {"verdict": "PASS", "evidence": "page id 필수·URL 라벨 전용·선택자 없는 스크린샷 레코드 유효성 테스트 통과."},
+    "P7-8": {"verdict": "PASS", "evidence": "차단 중 local storage 백업 후 재연결 원장 flush 및 저장용 eval 부재 테스트 통과."},
+    "P7-9": {"verdict": "SKIPPED", "evidence": "v0.2 범위이므로 지시대로 구현·검사하지 않음."},
+    "P7-10": {"verdict": "PASS", "evidence": "surface 필수와 work/explain 배타적 신원 유니온의 런타임·타입 검사 통과."},
+    "P7-11": {"verdict": "PASS", "evidence": "explain 코드 변경 요청이 동일한 주입 봉투 판정을 호출하며 거부 결과를 유지."},
+    "P7-12": {"verdict": "PASS", "evidence": "재생성 뒤 구 주석 버전 고정, 불변 주석 테이블, 직접 HTML 편집 경로 부재 검사 통과."},
+    "P7-live": {"verdict": "SKIPPED", "evidence": "실제 Orca 캡처·artifacts share는 외부 상태 금지에 따라 실행하지 않음."}
+  }
+}

diff --git a/daemon/migrations/004_p7.sql b/daemon/migrations/004_p7.sql
new file mode 100644
index 0000000000000000000000000000000000000000..175688798ca30d06104278a1869cfc1d9611fe16
--- /dev/null
+++ b/daemon/migrations/004_p7.sql
@@ -0,0 +1,30 @@
+PRAGMA foreign_keys = ON;
+
+CREATE TABLE IF NOT EXISTS result_record (
+  artifact_id TEXT NOT NULL,
+  version INTEGER NOT NULL CHECK (version > 0),
+  record_json TEXT NOT NULL,
+  created_at TEXT NOT NULL,
+  PRIMARY KEY (artifact_id, version)
+);
+
+CREATE TABLE IF NOT EXISTS annotation_v2 (
+  id TEXT PRIMARY KEY,
+  task_id TEXT NOT NULL REFERENCES task(id),
+  surface TEXT NOT NULL CHECK (surface IN ('work','explain')),
+  page_id TEXT,
+  artifact_id TEXT,
+  artifact_version INTEGER,
+  url_label TEXT,
+  selector TEXT,
+  screenshot_id TEXT NOT NULL,
+  korean_text TEXT NOT NULL CHECK (length(trim(korean_text)) > 0),
+  created_at TEXT NOT NULL,
+  CHECK (
+    (surface='work' AND page_id IS NOT NULL AND length(trim(page_id)) > 0 AND artifact_id IS NULL AND artifact_version IS NULL)
+    OR
+    (surface='explain' AND page_id IS NULL AND artifact_id IS NOT NULL AND length(trim(artifact_id)) > 0 AND artifact_version IS NOT NULL AND artifact_version > 0)
+  )
+);
+CREATE TRIGGER IF NOT EXISTS annotation_v2_no_update BEFORE UPDATE ON annotation_v2
+BEGIN SELECT RAISE(ABORT, 'annotations are immutable'); END;
