    const cli = tokenUsageFromExec({type:'turn.completed',usage:{input_tokens:3,output_tokens:2,total_tokens:5}});
    expect(applyTokenLimit({state:'running'},app,10)).toEqual({state:'blocked',reason:'budget'});
