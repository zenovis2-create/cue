+  if ($aceAdded -and $sidText) { & icacls.exe $payload.cwd /remove:g "*$sidText" /Q | Out-Null }
+  if ($sid -ne [IntPtr]::Zero) { [CueAppContainer]::LocalFree($sid) | Out-Null }
+  [CueAppContainer]::DeleteAppContainerProfile($profile) | Out-Null
+}
