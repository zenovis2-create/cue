+  const located = isAbsolute(command.executable) ? command.executable : spawnSync('where.exe', [command.executable], { encoding: 'utf8' }).stdout.split(/\r?\n/u).find(Boolean);
+  if (!located) return spawnSync(command.executable, ['--cue-executable-not-found'], { encoding: 'utf8' });
+  const commandLine = [located, ...command.args].map(quoteWindowsArg).join(' ');
+  const payload = Buffer.from(JSON.stringify({ executable: located, commandLine, cwd: command.cwd })).toString('base64');
+  return spawnSync('powershell.exe', ['-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', launcher, '-PayloadBase64', payload], { encoding: 'utf8' });
+}
