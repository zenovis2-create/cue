+    } finally {
+      if (capsPtr != IntPtr.Zero) Marshal.FreeHGlobal(capsPtr);
+      if (list != IntPtr.Zero) { DeleteProcThreadAttributeList(list); Marshal.FreeHGlobal(list); }
+    }
+  }
