+export interface WorkerLifecycle { db: Ledger; execution: ExecutionIdentity; now?: Date }
+
+export function runWorkerLifecycle(envelope: Envelope, command: WorkerCommand, lifecycle: WorkerLifecycle): WorkerResult {
