+  db.prepare('INSERT INTO envelope VALUES(?,?,?,?)').run(hash, worktree, '[]', now);
+  db.prepare('INSERT INTO run VALUES(?,?,?,?,?)').run('r3c', 't3c', hash, 0, now);
