+  if ($LASTEXITCODE -ne 0) { throw "icacls grant failed: $LASTEXITCODE" }
+  $aceAdded = $true
+  $exitCode = [CueAppContainer]::Launch($payload.executable, $payload.commandLine, $payload.cwd, $sid)
