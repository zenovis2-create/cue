+:root { color: #17191f; background: #f7f8fa; font-family: Inter, "Noto Sans KR", system-ui, sans-serif; }
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 900px; }
+header { height: 64px; display: flex; align-items: center; gap: 14px; padding: 0 28px; border-bottom: 1px solid #dfe3ea; background: #fff; font-size: 20px; }
+.mark { display: grid; place-items: center; width: 30px; height: 34px; border-radius: 7px; color: #fff; background: #1645bd; font-weight: 800; }
+main { min-height: calc(100vh - 64px); display: grid; grid-template-columns: 1.08fr .94fr .98fr; background: #fff; }
+section { padding: 36px 32px; border-right: 1px solid #dfe3ea; }
+section:last-child { border-right: 0; }
+h1 { margin: 0 0 24px; font-size: 23px; }
+h2 { color: #207b35; }
+textarea { width: 100%; min-height: 200px; resize: vertical; padding: 18px; border: 1px solid #cbd1db; border-radius: 10px; font: inherit; line-height: 1.55; }
+button { width: 100%; margin-top: 22px; padding: 15px; border: 0; border-radius: 8px; color: #fff; background: #1645bd; font: 700 16px inherit; cursor: pointer; }
+button.secondary { margin-top: 12px; color: #1645bd; border: 1px solid #1645bd; background: #fff; }
+button:disabled { cursor: not-allowed; opacity: .42; }
+.lines { margin-top: 28px; border: 1px solid #d9dde5; border-radius: 10px; overflow: hidden; }
+.lines div { display: grid; grid-template-columns: 116px 1fr; border-bottom: 1px solid #e3e6eb; }
+.lines div:last-child { border: 0; }
+dt, dd { margin: 0; padding: 18px; }
+dt { font-weight: 700; border-right: 1px solid #e3e6eb; }
+dd { color: #656b76; }
+.envelope { min-height: 260px; padding: 22px; border: 1px solid #cbd1db; border-radius: 10px; color: #555d69; line-height: 1.6; }
+fieldset { display: flex; justify-content: space-around; margin-top: 24px; padding: 18px; border: 1px solid #d9dde5; border-radius: 10px; }
+legend { padding: 0 8px; font-weight: 700; }
+fieldset label { font-size: 25px; }
+.quiet { color: #6d7480; }
+article { margin-top: 48px; padding: 24px; border: 1px solid #76b381; border-radius: 10px; background: #f7fcf8; }
diff --git a/daemon/test/p9.test.ts b/daemon/test/p9.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..0b5a5b4086bf2f55e1e066660f3cca741fe4b32c
--- /dev/null
+++ b/daemon/test/p9.test.ts
@@ -0,0 +1,83 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { mkdtempSync, readFileSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join, resolve } from 'node:path';
+import { createCueCore, initializeConfig, AppDaemon } from '../../app/core.mjs';
+import { assertAllowedChannel, IPC_CHANNELS, registerIpcHandlers } from '../../app/ipc.mjs';
+
+const roots: string[] = [];
+const temp = () => { const value = mkdtempSync(join(tmpdir(), 'cue-p9-')); roots.push(value); return value; };
+afterEach(() => { while (roots.length) rmSync(roots.pop()!, { recursive: true, force: true }); });
+
+describe('Phase 9 Electron shell', () => {
+  it('P9-1 has npm start and a main entrypoint', () => {
+    const pkg = JSON.parse(readFileSync(resolve('package.json'), 'utf8'));
+    expect(pkg.scripts.start).toBe('electron .');
+    expect(readFileSync(resolve(pkg.main), 'utf8')).toContain('BrowserWindow');
+  });
+
+  it('P9-2 seals BrowserWindow and exposes an explicit preload API only', () => {
+    const main = readFileSync(resolve('app/main.mjs'), 'utf8');
+    expect(main).toMatch(/contextIsolation:\s*true/u);
+    expect(main).toMatch(/nodeIntegration:\s*false/u);
+    expect(main).toMatch(/sandbox:\s*true/u);
+    const renderer = ['index.html', 'renderer.js', 'styles.css'].map(name => readFileSync(resolve('app/renderer', name), 'utf8')).join('\n');
+    expect(renderer).not.toMatch(/require\s*\(|child_process|better-sqlite3|\bfs\b/u);
+    const preload = readFileSync(resolve('app/preload.cjs'), 'utf8');
+    expect(preload).toContain("exposeInMainWorld('cue', allowedApi)");
+    expect(preload).not.toMatch(/exposeInMainWorld\([^,]+,\s*ipcRenderer/u);
+  });
+
+  it('P9-3 freezes channels, rejects unknown channels, and cannot execute before approval', () => {
+    expect(Object.isFrozen(IPC_CHANNELS)).toBe(true);
+    expect(() => assertAllowedChannel('cue:shell')).toThrow('IPC channel denied');
+    const root = temp(); const config = initializeConfig(join(root, 'data'), { worktreeRoot: root }); const core = createCueCore(config);
+    const prepared = core.prepareGoal('one file');
+    expect(() => core.execute(prepared.runId)).toThrow('approval required');
+    core.close();
+  });
+
+  it('P9-4 creates first-run config once, reuses it, and stores no credentials', () => {
+    const root = temp(); const data = join(root, 'data');
+    const first = initializeConfig(data, { worktreeRoot: root });
+    const second = initializeConfig(data, { worktreeRoot: temp() });
+    expect(second).toEqual(first);
+    const source = readFileSync(join(data, 'cue-config.json'), 'utf8');
+    expect(source).not.toMatch(/credential|password|secret|token|api[_-]?key/iu);
+  });
+
+  it('P9-5 closes the owned daemon and never restarts after crash', () => {
+    const root = temp(); const config = initializeConfig(join(root, 'data'), { worktreeRoot: root });
+    const daemon = new AppDaemon(config); const core = createCueCore(config, daemon); const prepared = core.prepareGoal('one file'); core.approve(prepared.runId);
+    daemon.crash(); expect(daemon.status).toBe('blocked/crash'); expect(() => core.execute(prepared.runId)).toThrow('daemon blocked/crash');
+    expect(daemon.status).toBe('blocked/crash'); core.close(); expect(daemon.status).toBe('closed');
+  });
+
+  it('P9-6/P9-7 records approval and default autonomy without widening the envelope', () => {
