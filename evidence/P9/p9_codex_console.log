+body { margin: 0; min-width: 900px; }
+header { height: 64px; display: flex; align-items: center; gap: 14px; padding: 0 28px; border-bottom: 1px solid #dfe3ea; background: #fff; font-size: 20px; }
+.mark { display: grid; place-items: center; width: 30px; height: 34px; border-radius: 7px; color: #fff; background: #1645bd; font-weight: 800; }
+main { min-height: calc(100vh - 64px); display: grid; grid-template-columns: 1.08fr .94fr .98fr; background: #fff; }
+section { padding: 36px 32px; border-right: 1px solid #dfe3ea; }
+section:last-child { border-right: 0; }
+h1 { margin: 0 0 24px; font-size: 23px; }
+h2 { color: #207b35; }
+textarea { width: 100%; min-height: 200px; resize: vertical; padding: 18px; border: 1px solid #cbd1db; border-radius: 10px; font: inherit; line-height: 1.55; }
+button { width: 100%; margin-top: 22px; padding: 15px; border: 0; border-radius: 8px; color: #fff; background: #1645bd; font: 700 16px inherit; cursor: pointer; }
+button.secondary { margin-top: 12px; color: #1645bd; border: 1px solid #1645bd; background: #fff; }
+button:disabled { cursor: not-allowed; opacity: .42; }
+.lines { margin-top: 28px; border: 1px solid #d9dde5; border-radius: 10px; overflow: hidden; }
+.lines div { display: grid; grid-template-columns: 116px 1fr; border-bottom: 1px solid #e3e6eb; }
