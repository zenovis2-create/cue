+.envelope { min-height: 260px; padding: 22px; border: 1px solid #cbd1db; border-radius: 10px; color: #555d69; line-height: 1.6; }
+fieldset { display: flex; justify-content: space-around; margin-top: 24px; padding: 18px; border: 1px solid #d9dde5; border-radius: 10px; }
+legend { padding: 0 8px; font-weight: 700; }
+fieldset label { font-size: 25px; }
+.quiet { color: #6d7480; }
+article { margin-top: 48px; padding: 24px; border: 1px solid #76b381; border-radius: 10px; background: #f7fcf8; }
