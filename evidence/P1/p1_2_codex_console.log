+def verdict_markdown(result: dict[str, Any]) -> str:
+    rows = []
+    expectations = {
+        "outside_decline": "decline 후 파일 없음",
+        "outside_accept": "accept여도 realpath worktree 경계가 파일 쓰기 차단",
