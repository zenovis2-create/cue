+        if s["name"] == "empty_permissions": measured += f"; interpretation={s.get('empty_response_interpretation')}"
+        rows.append(f"| `{s['name']}` | `{s['our_decision']}` | {expectations[s['name']]} | `{measured}` | **{s['verdict']}** |")
+    iso = result["isolation"]
