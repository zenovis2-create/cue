+        home = Path(home_s).resolve(); result["clean_home"] = clean_home(source_home, home)
+        env = os.environ.copy(); env["CODEX_HOME"] = str(home)
+        srv = AppServer(str(ledger), codex_bin=CODEX, env=env)
