+  rung INTEGER NOT NULL CHECK (rung BETWEEN 1 AND 4),
+  hypothesis TEXT NOT NULL CHECK (length(trim(hypothesis)) > 0),
+  outcome TEXT NOT NULL,
+  created_at TEXT NOT NULL,
+  UNIQUE(run_id, ordinal)
+);
