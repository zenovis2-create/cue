+  });
+
+  it.each([{level:1,actions:['stop'],attempts:0},{level:2,actions:['mechanical_retry','human'],attempts:1},{level:3,actions:['hypothesis_retry','change_approach'],attempts:2}] as const)('P5-9 autonomy $level has distinct lineage',({level,actions,attempts})=>{
+    const {db,recovery}=seeded(level,3), request={runId:'r',failure:'same',contract,actionAllowed:true};
