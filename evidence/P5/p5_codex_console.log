+    expect(rows.map(row=>row.rung)).toEqual([1,2,3,4]); expect(rows.slice(1).map(row=>row.parent_attempt_id)).toEqual(rows.slice(0,-1).map(row=>row.id));
+    expect(rows.every(row=>typeof row.hypothesis==='string' && row.hypothesis.length>0)).toBe(true); db.close();
+  });
+
+  it('P5-6 fences and hashes state before restart while preserving actual worker work',()=>{
+    const root=mkdtempSync(resolve('.test-state-p5-')); roots.push(root); const work=join(root,'worker.txt'); writeFileSync(work,'unfinished work');
+    const {db,recovery}=seeded(3,1); let observed:string[]=[];
