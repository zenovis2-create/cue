+    expect(observed).toEqual(['recovery_base_sha','recovery_diff_hash','restart_fence']); expect(readFileSync(work,'utf8')).toBe('unfinished work'); db.close();
+    expect(sourceText()).not.toMatch(/git\s+(?:reset|checkout|clean)|checkout\s+--|discard/iu);
