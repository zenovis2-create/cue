+      ['worktree','create','--name','cue-temp','--repo','path:C:/tmp/repo','--setup','skip','--json'], ['worktree','ps','--json'],
+      ['orchestration','task-list','--run','run-1','--json'], ['orchestration','worker-stop','--dispatch','dispatch-1','--json'],
