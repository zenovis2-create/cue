__pycache__/
*.pyc
.venv/
node_modules/

# Credential homes and path-shaped credential material must never be staged.
.codex/
**/codex-home-*/
**/auth.json
**/credentials.json
.env
.env.*

# Post-commit attestation embeds HEAD and cannot be part of its own commit.
/evidence/P11/v01_verdict.json

# Runtime/test state can contain copied credentials and ledgers.
daemon/.test-state-*/
evidence/**/live-state/
evidence/**/live-worktree/
evidence/**/electron-state/
evidence/**/electron-worktree/
evidence/**/manual-start-state/
evidence/**/npm-start-state/
evidence/**/npm-start-worktree/
evidence/**/stop-canary-state/
evidence/**/stop-canary-worktree/
evidence/**/*.sqlite
evidence/**/*.sqlite-*
evidence/**/*console.log
